# nightshift — the single config file (.env format), lives in ONE root:
#
#   ~/.nightshift/
#   ├── .env            ← this file, copied here
#   ├── bin/nightshift  ← symlink to the repo's bin/nightshift
#   ├── runids.txt      ← dispatch log (created automatically)
#   ├── cm-*            ← SSH ControlMaster sockets (created automatically)
#   └── landed/         ← default --land destination (created automatically)
#
# Nothing from this project installs anywhere else. Override the root with
# $NIGHTSHIFT_HOME if you insist. Make the CLI callable once:
#   echo 'export PATH="$HOME/.nightshift/bin:$PATH"' >> ~/.zshrc

# ── always-on machines ("targets") ────────────────────────────────────────
# Space-separated NAMES — they become shell variable components, so use
# plain identifiers: letters, digits, underscores (NO hyphens). Each name
# needs a matching <NAME>_HOST entry whose value is the machine's SSH alias
# (defined in ~/.ssh/config with a DEDICATED key — the CLI runs ssh under
# BatchMode: key auth mandatory, no prompts). Aliases themselves may
# contain hyphens; the NAMES may not.
# Add as many boxes as you like; --on <name> picks one per call, omitted =
# NIGHTSHIFT_DEFAULT_TARGET.
NIGHTSHIFT_TARGETS="home office"
NIGHTSHIFT_DEFAULT_TARGET="home"

NIGHTSHIFT_HOME_HOST="home-server"     # your primary always-on box
NIGHTSHIFT_OFFICE_HOST="office-server" # a second one, if you have it

# ── ports (defaults in effect unless overridden) ────────────────────────────
# Each target's gateway API binds 127.0.0.1:<API_PORT> on that machine
# (loopback-only — do not expose it on 0.0.0.0; the SSH tunnel is the front
# door). The local side of each tunnel is 127.0.0.1:<LOCAL_PORT>, assigned
# by position (18642, 18643, …) — override per target only on collision:
# NIGHTSHIFT_HOME_API_PORT="8642"      # default for every target
# NIGHTSHIFT_HOME_LOCAL_PORT="18642"   # by-position default
# NIGHTSHIFT_OFFICE_LOCAL_PORT="18643"
